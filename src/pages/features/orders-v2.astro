---
import { Background } from '@/components/background';
import { OrdersFeaturePageV2 } from '@/components/blocks/orders-feature-page-v2';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const title = "Order Management | Bloomwise";
const description = "Manage every order from intake to delivery. Track status, payments, and fulfillment across all channels—Shopify, phone, walk-in, and events.";
---

<DefaultLayout title={title} description={description}>
  <Background className="via-muted/50 to-muted/30">
    <OrdersFeaturePageV2 client:load />
  </Background>
</DefaultLayout>
