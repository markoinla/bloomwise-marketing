---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { Background } from '@/components/background';
import { FAQ } from '@/components/blocks/faq';
import { FeatureCarousel } from '@/components/blocks/feature-carousel';
import { Features } from '@/components/blocks/features';
import { Hero } from '@/components/blocks/hero';
import { HomepageCapabilities } from '@/components/blocks/homepage-capabilities';
import { HomepageCTA } from '@/components/blocks/homepage-cta';
import { HomepageShowcase } from '@/components/blocks/homepage-showcase';
import { Pricing } from '@/components/blocks/pricing';
import { Waitlist } from '@/components/blocks/waitlist';
import DefaultLayout from '@/layouts/DefaultLayout.astro';



---

<DefaultLayout title={SITE_TITLE} description={SITE_DESCRIPTION} >
  <Background className="via-muted to-muted/80">
    <Hero />
    <FeatureCarousel client:only='react' />
    <HomepageCapabilities client:only='react' />
    <Features client:only='react'/>
    <HomepageShowcase client:only='react' />
    <HomepageCTA client:only='react' />
  </Background>
  <FAQ client:only='react' />
</DefaultLayout>